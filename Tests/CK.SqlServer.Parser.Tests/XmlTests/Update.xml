  <Test>
    <Text>
      UPDATE Production.Product
      SET ListPrice = ListPrice * 1.10
      WHERE ProductNumber LIKE @Product
      OPTION (OPTIMIZE FOR (@Product = 'BK-%') )
    </Text>
    <Description>
      Specifying a query hint
    </Description>
    <Xml ToStringCompact="Assigns,WhereExpression">
      <Sql>
          <UpdateStatement>
            <Target>
              <MultiIdentifier>Production.Product</MultiIdentifier>
            </Target>
            <Assigns>ListPrice=ListPrice*1.10</Assigns>
            <WhereExpression>ProductNumber LIKE @Product</WhereExpression>
            <Options>
              <OptionParOptions>
                <Item>
                  <NodeList>
                    <Item>
                      <Identifier>OPTIMIZE</Identifier>
                    </Item>
                    <Item>
                      <KoCall FunName="FOR">
                        <Parameters>
                          <EnclosedCommaList>
                            <Item>
                              <BinaryOperator>
                                <Left>
                                  <Identifier IsVariable="true">@Product</Identifier>
                                </Left>
                                <Operator>
                                  <Terminal>=</Terminal>
                                </Operator>
                                <Right>
                                  <LiteralString>'BK-%'</LiteralString>
                                </Right>
                              </BinaryOperator>
                            </Item>
                          </EnclosedCommaList>
                        </Parameters>
                      </KoCall>
                    </Item>
                  </NodeList>
                </Item>
              </OptionParOptions>
            </Options>
          </UpdateStatement>
      </Sql>
    </Xml>
  </Test>

  <Test>
    <Text>
      UPDATE TOP (10) HumanResources.Employee
      SET VacationHours = VacationHours * 1.25,
          ModifiedDate = GETDATE() 
      OUTPUT inserted.BusinessEntityID "COL",
             deleted.VacationHours as First,
             'other' = inserted.VacationHours,
             [another] = inserted.ModifiedDate
      INTO @MyTableVar;
    </Text>
    <Description>
      Update top with output.
    </Description>
    <Xml ToStringCompact="Assigns,Item">
      <Sql>
        <UpdateStatement HasTerminator="true">
          <Top>
            <Par>
              <Content>
                <LiteralInteger>10</LiteralInteger>
              </Content>
            </Par>
          </Top>
          <Target>
            <MultiIdentifier>HumanResources.Employee</MultiIdentifier>
          </Target>
          <Assigns>VacationHours=VacationHours*1.25, ModifiedDate=GETDATE()</Assigns>
          <OutputClause>
            <OutputClause TargetTable="@MyTableVar">
              <Columns>
                <SelectColumnList>
                  <Item>inserted.BusinessEntityID "COL"</Item>
                  <Item>deleted.VacationHours as First</Item>
                  <Item>'other'=inserted.VacationHours</Item>
                  <Item>[another]=inserted.ModifiedDate</Item>
                </SelectColumnList>
              </Columns>
            </OutputClause>
          </OutputClause>
        </UpdateStatement>
      </Sql>
    </Xml>
  </Test>

  <Test>
    <Text>
      UPDATE HumanResources.Employee
      SET VacationHours = 
          ( CASE
               WHEN SalariedFlag = 0 THEN VacationHours + @NewHours
               ELSE @NewHours
             END
          )
    </Text>
    <Description>
      Update with case
    </Description>
    <Xml ToStringCompact="Operator">
      <Sql>
        <UpdateStatement>
          <Target>
            <MultiIdentifier>HumanResources.Employee</MultiIdentifier>
          </Target>
          <Assigns>
            <CommaList>
              <Item>
                <Assign>
                  <Left>
                    <Identifier>VacationHours</Identifier>
                  </Left>
                  <Operator>=</Operator>
                  <Right>
                    <Par>
                      <Content>
                        <Case>
                          <WhenList>
                            <CaseWhenList>
                              <Item>
                                <CaseWhenSelector>
                                  <Expression>
                                    <BinaryOperator>
                                      <Left>
                                        <Identifier>SalariedFlag</Identifier>
                                      </Left>
                                      <Operator>=</Operator>
                                      <Right>
                                        <LiteralInteger>0</LiteralInteger>
                                      </Right>
                                    </BinaryOperator>
                                  </Expression>
                                  <Value>
                                    <BinaryOperator>
                                      <Left>
                                        <Identifier>VacationHours</Identifier>
                                      </Left>
                                      <Operator>+</Operator>
                                      <Right>
                                        <Identifier IsVariable="true">@NewHours</Identifier>
                                      </Right>
                                    </BinaryOperator>
                                  </Value>
                                </CaseWhenSelector>
                              </Item>
                            </CaseWhenList>
                          </WhenList>
                        </Case>
                      </Content>
                    </Par>
                  </Right>
                </Assign>
              </Item>
            </CommaList>
          </Assigns>
        </UpdateStatement>
      </Sql>
    </Xml>
  </Test>


</Tests>