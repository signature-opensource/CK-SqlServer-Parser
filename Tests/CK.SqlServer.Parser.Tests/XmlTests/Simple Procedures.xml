  <Test>
    <Text>
      alter procedure dbo.ASimpleTestProcedure(
	        @NumberOfLines int, 
          @Two varchar(3) = 'abc', 
          @Three decimal(10,3),
          @Result datetime2(2) /*input*/output
      )
      as    
      begin
          set nocount on;
          set @Result = PARSE('Monday, 13 December 2010' AS datetime2 USING 'en-US');
          select top(@NumberOfLines) @Two, @Three, * from sys.databases;
          return 0;
      end
    </Text>
    <Xml>
      <Statements>
        <StoredProcedure StatementName="AlterProcedure">
            <SetOption HasTerminator="true" />
            <SetVariable HasTerminator="true" />
            <SelectStatement HasTerminator="true">
              <SelectSpec />
            </SelectStatement>
            <ReturnStatement HasTerminator="true" />
        </StoredProcedure>
      </Statements>
    </Xml>
  </Test>

  <Test>
    <Text>
      alter procedure sStrange -- funny one
      as
      begin
        begin tran
        print 1+2
        (select D = GETUTCDATE())
        (((select U = USER_NAME())))
        insert into _t$a@#b values(1)
        rollback
      end
    </Text>
    <Description>The 2 select statements are correctly detected (and not eaten by the 'print').</Description>
    <Xml>
      <Statements>
        <StoredProcedure StatementName="AlterProcedure">
            <BeginTransaction />
            <Statement StatementName="print" />
            <SelectStatement>
              <SelectSpec />
            </SelectStatement>
            <SelectStatement>
              <SelectSpec />
            </SelectStatement>
            <InsertStatement />
            <Statement StatementName="rollback" />
        </StoredProcedure>
      </Statements>
    </Xml>
  </Test>
  
  <Test>
    <Text>
      -- Version = 1.0.0, Package = TestMe
      create procedure sProcWithoutTerminator
      (
      @P int
      )
      as
      begin
      --[beginsp]
      select P = @P
      --[endsp]
      end
    </Text>
    <Description>Simple procedure.</Description>
    <Xml>
      <Sql>
        <StoredProcedure StatementName="CreateProcedure">
          <Name>sProcWithoutTerminator</Name>
          <Parameters>
            <ParameterList IsEnclosed="true">
              <Item>
                <Parameter Name="@P" Direction="Input">
                  <Type>
                    <TypeDeclSimple DBType="Int" Text="int" />
                  </Type>
                </Parameter>
              </Item>
            </ParameterList>
          </Parameters>
          <Body>
            <StatementList>
              <Item>
                <SelectStatement>
                  <Select>
                    <SelectSpec>
                      <Columns>
                        <SelectColumnList>
                          <Item>
                            <SelectColumn ColumnName="P">
                              <Definition>
                                <Identifier IsVariable="true">@P</Identifier>
                              </Definition>
                            </SelectColumn>
                          </Item>
                        </SelectColumnList>
                      </Columns>
                    </SelectSpec>
                  </Select>
                </SelectStatement>
              </Item>
            </StatementList>
          </Body>
        </StoredProcedure>
      </Sql>
    </Xml>
  </Test>

  <Test>
    <Text>
      CREATE PROCEDURE dbo.uspCurrencyCursor 
          @CurrencyCursor CURSOR VARYING OUTPUT
      AS
          SET NOCOUNT ON
          SET @CurrencyCursor = CURSOR
          FORWARD_ONLY STATIC FOR
            SELECT CurrencyCode, Name
            FROM Sales.Currency;
          OPEN @CurrencyCursor
    </Text>
    <Description>CURSOR VARYING is a special case of type declaration that applies only to parameters.</Description>
    <Xml ToStringCompact="SetOption, CursorDefinition">
      <Sql>
        <StoredProcedure StatementName="CreateProcedure">
          <Name>dbo.uspCurrencyCursor</Name>
          <Parameters>
            <ParameterList>
              <Item>
                <Parameter Name="@CurrencyCursor" Direction="Output">
                  <Type>
                    <TypeDeclCursorParameter DBType="Udt" Text="CURSOR VARYING" />
                  </Type>
                </Parameter>
              </Item>
            </ParameterList>
          </Parameters>
          <Body>
            <StatementList>
            <Item>
                <SetOption>SET NOCOUNT ON</SetOption>
              </Item>
              <Item>
                <SetVariable HasTerminator="true">
                  <Variable>
                    <Identifier IsVariable="true">@CurrencyCursor</Identifier>
                  </Variable>
                  <AssignT>
                    <Terminal>=</Terminal>
                  </AssignT>
                  <Value>
                    <CursorDefinition>CURSOR FORWARD_ONLY STATIC FOR SELECT CurrencyCode, Name FROM Sales.Currency</CursorDefinition>
                  </Value>
                </SetVariable>
              </Item>
              <Item>
                <Statement StatementName="OPEN">
                  <Content>
                    <Identifier IsVariable="true">@CurrencyCursor</Identifier>
                  </Content>
                </Statement>
              </Item>
            </StatementList>
          </Body>
        </StoredProcedure>
      </Sql>
    </Xml>
  </Test>

  
  
</Tests>