  <Test>
    <Text>
      INSERT TOP(5) percent INTO dbo.EmployeeSales
        OUTPUT inserted.EmployeeID, inserted.FirstName
        SELECT sp.BusinessEntityID, c.LastName
        FROM Sales.SalesPerson AS sp
        INNER JOIN Person.Person AS c ON sp.BusinessEntityID = c.BusinessEntityID
        WHERE sp.SalesYTD > 250000.00
        ORDER BY sp.SalesYTD DESC;
    </Text>
    <Description></Description>
    <Xml Shorten="From">
      <Sql>
        <InsertStatement HasTerminator="true">
          <Top Percent="true">
            <Par>
              <Content>
                <LiteralInteger>5</LiteralInteger>
              </Content>
            </Par>
          </Top>
          <Target>
            <MultiIdentifier>dbo.EmployeeSales</MultiIdentifier>
          </Target>
          <OutputClause>
            <OutputClause>
              <Columns>
                <SelectColumnList>
                  <Item>
                    <SelectColumn>
                      <Definition>
                        <MultiIdentifier>inserted.EmployeeID</MultiIdentifier>
                      </Definition>
                    </SelectColumn>
                  </Item>
                  <Item>
                    <SelectColumn>
                      <Definition>
                        <MultiIdentifier>inserted.FirstName</MultiIdentifier>
                      </Definition>
                    </SelectColumn>
                  </Item>
                </SelectColumnList>
              </Columns>
            </OutputClause>
          </OutputClause>
          <Values>
            <SelectDecorator>
              <Select>
                <SelectSpec>
                  <Columns>
                    <SelectColumnList>
                      <Item>
                        <SelectColumn>
                          <Definition>
                            <MultiIdentifier>sp.BusinessEntityID</MultiIdentifier>
                          </Definition>
                        </SelectColumn>
                      </Item>
                      <Item>
                        <SelectColumn>
                          <Definition>
                            <MultiIdentifier>c.LastName</MultiIdentifier>
                          </Definition>
                        </SelectColumn>
                      </Item>
                    </SelectColumnList>
                  </Columns>
                  <From>FROM Sales.SalesPerson AS sp INNER JOIN Person.Person AS c ON sp.BusinessEntityID = c.BusinessEntityID</From>
                  <WhereExpression>
                    <BinaryOperator>
                      <Left>
                        <MultiIdentifier>sp.SalesYTD</MultiIdentifier>
                      </Left>
                      <Operator>
                        <Terminal>&gt;</Terminal>
                      </Operator>
                      <Right>
                        <LiteralDecimal>250000.00</LiteralDecimal>
                      </Right>
                    </BinaryOperator>
                  </WhereExpression>
                </SelectSpec>
              </Select>
              <OrderBy>
                <SelectOrderBy>
                  <OrderByColumns>
                    <OrderByList>
                      <Item>
                        <OrderByItem Desc="true">
                          <Definition>
                            <MultiIdentifier>sp.SalesYTD</MultiIdentifier>
                          </Definition>
                        </OrderByItem>
                      </Item>
                    </OrderByList>
                  </OrderByColumns>
                </SelectOrderBy>
              </OrderBy>
            </SelectDecorator>
          </Values>
        </InsertStatement>
      </Sql>
    </Xml>
  </Test>

