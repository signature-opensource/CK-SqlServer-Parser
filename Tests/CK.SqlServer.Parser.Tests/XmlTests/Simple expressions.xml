<?xml version="1.0" encoding="utf-8" ?>
<Tests>

  <Test Mode="OneExpression">
    <Text>null</Text>
    <Description>Null, even if it is a reserved keyword is a simple identifier.</Description>
    <Xml>
      <Sql>
        <Identifier IsReservedKeyword="true">null</Identifier>
      </Sql>
    </Xml>
  </Test>

  <Test Mode="OneExpression">
    <Text>not null</Text>
    <Description>Not null: unary operator.</Description>
    <Xml>
      <Sql>
        <UnaryOperator>
          <Operator>
            <Identifier IsReservedKeyword="true">not</Identifier>
          </Operator>
          <Right>
            <Identifier IsReservedKeyword="true">null</Identifier>
          </Right>
        </UnaryOperator>
      </Sql>
    </Xml>
  </Test>

  <Test Mode="OneExpression">
    <Text>x is not null</Text>
    <Description>Is not null: unary operator.</Description>
    <Xml>
      <Sql>
        <IsNull IsNotNull="true">
          <Left>
            <Identifier>x</Identifier>
          </Left>
        </IsNull>
      </Sql>
    </Xml>
  </Test>

  <Test Mode="ExtendedExpression">
    <Text>XXX not null</Text>
    <Description>This is not an expression: this is understood as an identifier and a Not unary operator.</Description>
    <Xml>
      <Sql>
        <NodeList>
          <Item>
            <Identifier>XXX</Identifier>
          </Item>
          <Item>
            <UnaryOperator>
              <Operator>
                <Identifier IsReservedKeyword="true">not</Identifier>
              </Operator>
              <Right>
                <Identifier IsReservedKeyword="true">null</Identifier>
              </Right>
            </UnaryOperator>
          </Item>
        </NodeList>
      </Sql>
    </Xml>
  </Test>

  <Test Mode="OneExpression">
    <Text>4 + 5</Text>
    <Description>Simple addition.</Description>
    <Xml CombineElementType="true">
      <Sql Type="BinaryOperator">
        <Left Type="LiteralInteger">4</Left>
        <Operator Type="Terminal">+</Operator>
        <Right Type="LiteralInteger">5</Right>
      </Sql>
    </Xml>
  </Test>

  <Test Mode="OneExpression">
    <Text>(4 + 5)</Text>
    <Description>Expresion inside parenthesis.</Description>
    <Xml CombineElementType="true">
      <Sql Type="Par">
        <Content Type="BinaryOperator">
          <Left Type="LiteralInteger">4</Left>
          <Operator Type="Terminal">+</Operator>
          <Right Type="LiteralInteger">5</Right>
        </Content>
      </Sql>
    </Xml>
  </Test>

  <Test Mode="OneExpression">
    <Text>(4 + ((5)))</Text>
    <Description>Multiple parenthesis.</Description>
    <Xml CombineElementType="true">
      <Sql Type="Par">
        <Content Type="BinaryOperator">
          <Left Type="LiteralInteger">4</Left>
          <Operator Type="Terminal">+</Operator>
          <Right Type="Par">
            <Content Type="Par">
              <Content Type="LiteralInteger">5</Content>
            </Content>
          </Right>
        </Content>
      </Sql>
    </Xml>
  </Test>

  <Test Mode="OneExpression">
  <Text>-10+2</Text>
    <Description>Unary minus operator with +: additive precedence.</Description>
    <Xml CombineElementType="true">
      <Sql Type="BinaryOperator">
        <Left Type="UnaryOperator">
          <Operator Type="Terminal">-</Operator>
          <Right Type="LiteralInteger">10</Right>
        </Left>
        <Operator Type="Terminal">+</Operator>
        <Right Type="LiteralInteger">2</Right>
      </Sql>
    </Xml>
  </Test>

  <Test Mode="OneExpression">
    <Text>-10.89-2e4</Text>
    <Description>Unary minus operator with -: additive precedence.</Description>
    <Xml CombineElementType="true">
      <Sql Type="BinaryOperator">
        <Left Type="UnaryOperator">
          <Operator Type="Terminal">-</Operator>
          <Right Type="LiteralDecimal">10.89</Right>
        </Left>
        <Operator Type="Terminal">-</Operator>
        <Right Type="LiteralFloat">2e4</Right>
      </Sql>
    </Xml>
  </Test>

  <Test Mode="OneExpression">
    <Text>-1*2</Text>
    <Description>Unary minus operator with *: additive precedence.</Description>
    <Xml CombineElementType="true">
      <Sql Type="UnaryOperator">
        <Operator Type="Terminal">-</Operator>
        <Right Type="BinaryOperator">
          <Left Type="LiteralInteger">1</Left>
          <Operator Type="Terminal">*</Operator>
          <Right Type="LiteralInteger">2</Right>
        </Right>
      </Sql>
    </Xml>
  </Test>

  <Test Mode="OneExpression">
    <Text>-1*2+3</Text>
    <Description>Unary minus operator with */+: additive precedence.</Description>
    <Xml CombineElementType="true">
      <Sql Type="BinaryOperator">
        <Left Type="UnaryOperator">
          <Operator Type="Terminal">-</Operator>
          <Right Type="BinaryOperator">
            <Left Type="LiteralInteger">1</Left>
            <Operator Type="Terminal">*</Operator>
            <Right Type="LiteralInteger">2</Right>
          </Right>
        </Left>
        <Operator Type="Terminal">+</Operator>
        <Right Type="LiteralInteger">3</Right>
      </Sql>
    </Xml>
  </Test>

  <Test Mode="OneExpression">
    <Text>simple_call()</Text>
    <Description></Description>
    <Xml>
      <Sql>
        <KoCall FunName="simple_call">
          <Parameters>
            <EnclosedCommaList />
          </Parameters>
        </KoCall>
      </Sql>
    </Xml>
  </Test>

  <Test Mode="OneExpression">
    <Text>a::call( 3+2, simple_call() )</Text>
    <Description></Description>
    <Xml>
      <Sql>
        <KoCall FunName="a::call">
          <Parameters>
            <EnclosedCommaList>
              <Item>
                <BinaryOperator>
                  <Left>
                    <LiteralInteger>3</LiteralInteger>
                  </Left>
                  <Operator><Terminal>+</Terminal></Operator>
                  <Right>
                    <LiteralInteger>2</LiteralInteger>
                  </Right>
                </BinaryOperator>                
              </Item>
              <Item>
                <KoCall FunName="simple_call">
                  <Parameters>
                    <EnclosedCommaList />
                  </Parameters>
                </KoCall>
              </Item>
            </EnclosedCommaList>
          </Parameters>
        </KoCall>
      </Sql>
    </Xml>
  </Test>

</Tests>