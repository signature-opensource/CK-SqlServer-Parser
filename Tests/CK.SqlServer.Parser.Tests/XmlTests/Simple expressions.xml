<?xml version="1.0" encoding="utf-8" ?>
<Tests>

  <Test Mode="OneExpression">
    <Text>null</Text>
    <Description>Null, even if it is a reserved keyword is a simple identifier.</Description>
    <Xml>
      <Sql>
        <Identifier IsReservedKeyword="true">null</Identifier>
      </Sql>
    </Xml>
  </Test>

  <Test Mode="OneExpression">
    <Text>not null</Text>
    <Description>Not null: unary operator.</Description>
    <Xml>
      <Sql>
        <UnaryOperator>
          <Operator>
            <Identifier IsReservedKeyword="true">not</Identifier>
          </Operator>
          <Right>
            <Identifier IsReservedKeyword="true">null</Identifier>
          </Right>
        </UnaryOperator>
      </Sql>
    </Xml>
  </Test>

  <Test Mode="OneExpression">
    <Text>x is not null</Text>
    <Description>Is not null: unary operator.</Description>
    <Xml>
      <Sql>
        <IsNull IsNotNull="true">
          <Left>
            <Identifier>x</Identifier>
          </Left>
        </IsNull>
      </Sql>
    </Xml>
  </Test>

  <Test Mode="ExtendedExpression">
    <Text>XXX not null</Text>
    <Description>This is not an expression: this is understood as an identifier and a Not unary operator.</Description>
    <Xml>
      <Sql>
        <NodeList>
          <Item>
            <Identifier>XXX</Identifier>
          </Item>
          <Item>
            <UnaryOperator>
              <Operator>
                <Identifier IsReservedKeyword="true">not</Identifier>
              </Operator>
              <Right>
                <Identifier IsReservedKeyword="true">null</Identifier>
              </Right>
            </UnaryOperator>
          </Item>
        </NodeList>
      </Sql>
    </Xml>
  </Test>

  <Test Mode="OneExpression">
    <Text>values</Text>
    <Description>'values' alone is an identifier.</Description>
    <Xml>
      <Sql>
        <Identifier IsReservedKeyword="true">values</Identifier>
      </Sql>
    </Xml>
  </Test>

  <Test Mode="OneExpression">
    <Text>values (a,b,c), (), (d), (e,f)</Text>
    <Description>'values' is the table values constructor.</Description>
    <Xml>
      <Sql>
        <TableValues>
          <Values>
            <MultiCommaList>
              <Item>
                <EnclosedCommaList>
                  <Item>
                    <Identifier>a</Identifier>
                  </Item>
                  <Item>
                    <Identifier>b</Identifier>
                  </Item>
                  <Item>
                    <Identifier>c</Identifier>
                  </Item>
                </EnclosedCommaList>
              </Item>
              <Item>
                <EnclosedCommaList />
              </Item>
              <Item>
                <EnclosedCommaList>
                  <Item>
                    <Identifier>d</Identifier>
                  </Item>
                </EnclosedCommaList>
              </Item>
              <Item>
                <EnclosedCommaList>
                  <Item>
                    <Identifier>e</Identifier>
                  </Item>
                  <Item>
                    <Identifier>f</Identifier>
                  </Item>
                </EnclosedCommaList>
              </Item>
            </MultiCommaList>
          </Values>
        </TableValues>
      </Sql>
    </Xml>
  </Test>

  <Test Mode="OneExpression">
    <Text>values (a)</Text>
    <Description>'values' is the table values constructor.</Description>
    <Xml>
      <Sql>
        <TableValues>
          <Values>
            <MultiCommaList>
              <Item>
                <EnclosedCommaList>
                  <Item>
                    <Identifier>a</Identifier>
                  </Item>
                </EnclosedCommaList>
              </Item>
            </MultiCommaList>
          </Values>
        </TableValues>
      </Sql>
    </Xml>
  </Test>

  <Test Mode="OneExpression">
    <Text>4 + 5</Text>
    <Description>Simple addition.</Description>
    <Xml CombineElementType="true">
      <Sql EType="BinaryOperator">
        <Left EType="LiteralInteger">4</Left>
        <Operator EType="Terminal">+</Operator>
        <Right EType="LiteralInteger">5</Right>
      </Sql>
    </Xml>
  </Test>

  <Test Mode="OneExpression">
    <Text>(4 + 5)</Text>
    <Description>Expresion inside parenthesis.</Description>
    <Xml CombineElementType="true">
      <Sql EType="Par">
        <Content EType="BinaryOperator">
          <Left EType="LiteralInteger">4</Left>
          <Operator EType="Terminal">+</Operator>
          <Right EType="LiteralInteger">5</Right>
        </Content>
      </Sql>
    </Xml>
  </Test>

  <Test Mode="OneExpression">
    <Text>(4 + ((5)))</Text>
    <Description>Multiple parenthesis.</Description>
    <Xml CombineElementType="true">
      <Sql EType="Par">
        <Content EType="BinaryOperator">
          <Left EType="LiteralInteger">4</Left>
          <Operator EType="Terminal">+</Operator>
          <Right EType="Par">
            <Content EType="Par">
              <Content EType="LiteralInteger">5</Content>
            </Content>
          </Right>
        </Content>
      </Sql>
    </Xml>
  </Test>

  <Test Mode="OneExpression">
  <Text>-10+2</Text>
    <Description>Unary minus operator with +: additive precedence.</Description>
    <Xml CombineElementType="true">
      <Sql EType="BinaryOperator">
        <Left EType="UnaryOperator">
          <Operator EType="Terminal">-</Operator>
          <Right EType="LiteralInteger">10</Right>
        </Left>
        <Operator EType="Terminal">+</Operator>
        <Right EType="LiteralInteger">2</Right>
      </Sql>
    </Xml>
  </Test>

  <Test Mode="OneExpression">
    <Text>-10.89-2e4</Text>
    <Description>Unary minus operator with -: additive precedence.</Description>
    <Xml CombineElementType="true">
      <Sql EType="BinaryOperator">
        <Left EType="UnaryOperator">
          <Operator EType="Terminal">-</Operator>
          <Right EType="LiteralDecimal">10.89</Right>
        </Left>
        <Operator EType="Terminal">-</Operator>
        <Right EType="LiteralFloat">2e4</Right>
      </Sql>
    </Xml>
  </Test>

  <Test Mode="OneExpression">
    <Text>-1*2</Text>
    <Description>Unary minus operator with *: additive precedence.</Description>
    <Xml CombineElementType="true">
      <Sql EType="UnaryOperator">
        <Operator EType="Terminal">-</Operator>
        <Right EType="BinaryOperator">
          <Left EType="LiteralInteger">1</Left>
          <Operator EType="Terminal">*</Operator>
          <Right EType="LiteralInteger">2</Right>
        </Right>
      </Sql>
    </Xml>
  </Test>

  <Test Mode="OneExpression">
    <Text>-1*2+3</Text>
    <Description>Unary minus operator with */+: additive precedence.</Description>
    <Xml CombineElementType="true">
      <Sql EType="BinaryOperator">
        <Left EType="UnaryOperator">
          <Operator EType="Terminal">-</Operator>
          <Right EType="BinaryOperator">
            <Left EType="LiteralInteger">1</Left>
            <Operator EType="Terminal">*</Operator>
            <Right EType="LiteralInteger">2</Right>
          </Right>
        </Left>
        <Operator EType="Terminal">+</Operator>
        <Right EType="LiteralInteger">3</Right>
      </Sql>
    </Xml>
  </Test>

  <Test Mode="OneExpression">
    <Text>simple_call()</Text>
    <Description></Description>
    <Xml>
      <Sql>
        <KoCall FunName="simple_call">
          <Parameters>
            <EnclosedCommaList />
          </Parameters>
        </KoCall>
      </Sql>
    </Xml>
  </Test>

  <Test Mode="OneExpression">
    <Text>a::call( 3+2, simple_call() )</Text>
    <Description></Description>
    <Xml>
      <Sql>
        <KoCall FunName="a::call">
          <Parameters>
            <EnclosedCommaList>
              <Item>
                <BinaryOperator>
                  <Left>
                    <LiteralInteger>3</LiteralInteger>
                  </Left>
                  <Operator><Terminal>+</Terminal></Operator>
                  <Right>
                    <LiteralInteger>2</LiteralInteger>
                  </Right>
                </BinaryOperator>                
              </Item>
              <Item>
                <KoCall FunName="simple_call">
                  <Parameters>
                    <EnclosedCommaList />
                  </Parameters>
                </KoCall>
              </Item>
            </EnclosedCommaList>
          </Parameters>
        </KoCall>
      </Sql>
    </Xml>
  </Test>

  <Test Mode="OneExpression">
    <Text>
      ( (((('U' COLLATE greek_ci_as)))) + (((( ((LatinCol)) COLLATE greek_ci_as)))) ) + GreekCol  + 'P'
    </Text>
    <Description>Conacatenation, parenthesis and collate operator.</Description>
    <Xml>
      <Sql>
        <BinaryOperator>
          <Left>
            <BinaryOperator>
              <Left>
                <Par>
                  <Content>
                    <BinaryOperator>
                      <Left>
                        <Par>
                          <Content>
                            <Par>
                              <Content>
                                <Par>
                                  <Content>
                                    <Par>
                                      <Content>
                                        <Collate CollationName="greek_ci_as">
                                          <Left>
                                            <LiteralString>'U'</LiteralString>
                                          </Left>
                                        </Collate>
                                      </Content>
                                    </Par>
                                  </Content>
                                </Par>
                              </Content>
                            </Par>
                          </Content>
                        </Par>
                      </Left>
                      <Operator>
                        <Terminal>+</Terminal>
                      </Operator>
                      <Right>
                        <Par>
                          <Content>
                            <Par>
                              <Content>
                                <Par>
                                  <Content>
                                    <Par>
                                      <Content>
                                        <Collate CollationName="greek_ci_as">
                                          <Left>
                                            <Par>
                                              <Content>
                                                <Par>
                                                  <Content>
                                                    <Identifier>LatinCol</Identifier>
                                                  </Content>
                                                </Par>
                                              </Content>
                                            </Par>
                                          </Left>
                                        </Collate>
                                      </Content>
                                    </Par>
                                  </Content>
                                </Par>
                              </Content>
                            </Par>
                          </Content>
                        </Par>
                      </Right>
                    </BinaryOperator>
                  </Content>
                </Par>
              </Left>
              <Operator>
                <Terminal>+</Terminal>
              </Operator>
              <Right>
                <Identifier>GreekCol</Identifier>
              </Right>
            </BinaryOperator>
          </Left>
          <Operator>
            <Terminal>+</Terminal>
          </Operator>
          <Right>
            <LiteralString>'P'</LiteralString>
          </Right>
        </BinaryOperator>
      </Sql>
    </Xml>
  </Test>


</Tests>